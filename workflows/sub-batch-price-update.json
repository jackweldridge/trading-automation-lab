    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO daily_prices (ticker, date, open, high, low, close, adjusted_close, volume)\nSELECT DISTINCT ON (ticker, date)\n       ticker, date::date, open, high, low, close, adjusted_close, volume\nFROM json_to_recordset($JSON$ {{ JSON.stringify($input.all().map(i => ({ ...i.json, ticker: $('When Executed by Another Workflow').first().json.ticker }))) }} $JSON$::json)\n  AS x(ticker text, date text, open numeric, high numeric, low numeric,\n       close numeric, adjusted_close numeric, volume bigint)\nWHERE ticker IS NOT NULL AND date IS NOT NULL AND close IS NOT NULL\nORDER BY ticker, date, adjusted_close DESC NULLS LAST\nON CONFLICT (ticker, date) DO UPDATE SET\n  open = excluded.open, high = excluded.high, low = excluded.low,\n  close = excluded.close, adjusted_close = excluded.adjusted_close,\n  volume = excluded.volume;",
        "options": {}
      },
