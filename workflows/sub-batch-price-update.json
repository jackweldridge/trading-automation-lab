    {
      "parameters": {
        "jsCode": "// last node in the sub-workflow: what the parent collects. Keep it small - the\n// parent accumulates one of these per child, so returning the loaded rows here\n// would just move the accumulation problem up a level.\nconst ticker = $('When Executed by Another Workflow').first().json.ticker;\nconst loaded = $('Daily Prices Load1').all().length;\nreturn [{ json: { ticker, rows_loaded: loaded } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        432,
        32
      ],
      "id": "116096c1-d9af-45a6-9b5f-3a26d0fd3ce1",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT ticker,\n       case when type = 'Common Stock' then LEAST(current_date - ipo_date, current_date - '2011-12-31'::date)\n  else LEAST(current_date - ipo_date, current_date - '2021-12-31'::date) end AS hist_start_days\nFROM universe\nwhere type = 'Common Stock'\nand ipo_date <= '2021-12-31'",
        "options": {}
