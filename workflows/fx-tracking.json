    {
      "parameters": {
        "jsCode": "// Split Yahoo FX response into one item per currency pair\n// Input: single item with chart array, OR multiple items each with one chart\n// Output: one item per currency, with clean rate field\n\nconst allItems = $input.all();\nconst output = [];\n\nfor (const item of allItems) {\n  // Yahoo can return either a single {chart:{...}} object or an array of them\n  // Normalize to array form\n  const charts = Array.isArray(item.json) ? item.json : [item.json];\n\n  for (const entry of charts) {\n    const result = entry?.chart?.result?.[0];\n    if (!result) continue;\n\n    const symbol = result.meta?.symbol;        // e.g. \"USDGBP=X\"\n    const rate   = result.meta?.regularMarketPrice;\n\n    if (!symbol || rate == null) continue;\n\n    // Parse \"FROMTO=X\" → from + to\n    const match = symbol.match(/^([A-Z]{3})?([A-Z]{3})=X$/);\n    if (!match) continue;\n    const fromCcy = match[1] || 'USD';   // GBP=X means USD/GBP\n    const toCcy   = match[2];\n\n    output.push({\n      json: {\n        symbol,\n        fromCurrency: fromCcy,\n        toCurrency:   toCcy,\n        rate:         rate,\n        rateAsOf:     result.meta?.regularMarketTime\n                        ? new Date(result.meta.regularMarketTime * 1000).toISOString()\n                        : null,\n        dayHigh:      result.meta?.regularMarketDayHigh ?? null,\n        dayLow:       result.meta?.regularMarketDayLow ?? null,\n        previousClose: result.meta?.chartPreviousClose ?? null,\n      },\n    });\n  }\n}\n\nreturn output;"
      },
