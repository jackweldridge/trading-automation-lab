    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO fx_rate_daily (currency, rate_date, usd_per_unit)\nVALUES (\n  $1,                                   -- currency\n  $2,                                   -- rate_date\n  CASE\n    WHEN left($3, 3) = 'USD'            -- USDxxx: close is units/USD -> invert to USD/unit\n      THEN 1.0 / NULLIF($4::numeric, 0)\n    ELSE $4::numeric                     -- xxxUSD: close is already USD/unit\n  END                                    -- $3 = currency_pair, $4 = close\n)\nON CONFLICT (currency, rate_date)\nDO UPDATE SET usd_per_unit = EXCLUDED.usd_per_unit, as_of = now();",
        "options": {
          "queryReplacement": "={{ [$('Loop Over Items').item.json.currency.trim(), $json.date, $('Loop Over Items').item.json.currency_pair.trim(), Number($json.adjusted_close)] }}"
        }
      },
