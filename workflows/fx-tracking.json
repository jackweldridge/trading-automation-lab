    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT DISTINCT\n  norm.currency,\n  CASE\n    WHEN norm.currency = ANY (ARRAY['EUR','GBP','AUD','NZD'])\n      THEN norm.currency || 'USD'      -- these trade CCY-base (EURUSD, GBPUSD)\n    ELSE 'USD' || norm.currency          -- everything else is USD-base (USDVND, USDCNY, USDJPY)\n  END AS currency_pair\nFROM (\n  SELECT DISTINCT\n    CASE WHEN currency = 'GBX' THEN 'GBP' ELSE currency END AS currency\n  FROM fundamentals_facts\n  WHERE currency IS NOT NULL AND currency <> '' AND currency <> 'USD'\n) norm\n  --where currency = 'PLN' not in ('VND','CNY','GBX','GBP');",
