    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH attempted_update AS (\n    UPDATE gateway_restart_lock\n    SET locked     = TRUE,\n        locked_at  = NOW(),\n        locked_by  = '{{ $execution.id }}'\n    WHERE id = 1\n      AND (\n            locked = FALSE                              \n            OR locked_at < NOW() - INTERVAL '30 minutes' \n          )\n    RETURNING *\n)\n-- 1. If the update succeeded, return that row and mark lock_acquired as true\nSELECT *, TRUE AS lock_acquired \nFROM attempted_update\n\nUNION ALL\n\n-- 2. If the update failed, fallback to pulling the current state and mark lock_acquired as false\nSELECT *, FALSE AS lock_acquired \nFROM gateway_restart_lock\nWHERE id = 1 \n  AND NOT EXISTS (SELECT 1 FROM attempted_update);\n",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
