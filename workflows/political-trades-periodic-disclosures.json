    {
      "parameters": {
        "jsCode": "// PTR workflow :: \"Trades to rows\" — after the parser, before a Postgres \"Execute Query\" node.\n// Normalises the parsed PTR rows (MM/DD/YYYY dates -> ISO, upper-case tickers, BUY/SELL) and\n// returns ONE item carrying the whole batch as JSON, so the insert needs no query parameters.\nconst iso = s => { if (!s) return null; const m = String(s).trim().match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})$/);\n  if (m) return `${m[3]}-${m[1].padStart(2,'0')}-${m[2].padStart(2,'0')}`; return /^\\d{4}-\\d{2}-\\d{2}$/.test(s) ? s : null; };\nconst rows = [];\nfor (const it of $input.all()) {\n  const j = it.json || {};\n  const ticker = String(j.ticker || '').trim().toUpperCase();\n  const filing = iso(j.filing_date);\n  if (!ticker || !filing || !j.filer_name) continue;                    // unusable row\n  const action = /sell|sale|sold/i.test(j.action || '') ? 'SELL' : /buy|purchase/i.test(j.action || '') ? 'BUY' : String(j.action || '').toUpperCase();\n  rows.push({ filing_id: String(j.filing_id || ''), filer_name: String(j.filer_name).trim(), ticker,\n    asset_name: j.asset_name || null, action, instrument: (j.instrument || 'shares').toLowerCase(),\n    transaction_date: iso(j.transaction_date), notification_date: iso(j.notification_date), filing_date: filing,\n    description: j.description || null });\n}\nreturn [{ json: { payload: JSON.stringify(rows).replace(/\\$v\\$/g, ''), n: rows.length } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1808,
        -288
      ],
      "id": "3c4ef04a-a8b4-4994-8a43-dbeb6f877e33",
      "name": "Code in JavaScript"
