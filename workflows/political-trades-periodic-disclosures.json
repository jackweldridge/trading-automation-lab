    {
      "parameters": {
        "jsCode": "const allTrades = [];\n\nfor (const item of $('Message a model').all()) {\n  const text = item.json.output?.[0]?.content?.[0]?.text;\n  if (!text) continue;\n\n  const parsed = typeof text === 'string' ? JSON.parse(text) : text;\n  const { filer_name, filing_date, filing_id, trades } = parsed;\n\n  if (!Array.isArray(trades)) continue;\n\n  for (const trade of trades) {\n    allTrades.push({\n      json: {\n        filer_name,\n        filing_date,\n        filing_id,\n        ...trade\n      }\n    });\n  }\n}\n\nreturn allTrades;"
      },
