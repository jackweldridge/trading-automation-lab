    {
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into politician_trade (filing_id, filer_name, ticker, asset_name, action, instrument,\n                        transaction_date, notification_date, filing_date, description)\nselect filing_id, filer_name, ticker, asset_name, action, instrument,\n       transaction_date, notification_date, filing_date, description\nfrom jsonb_populate_recordset(null::politician_trade, $v$ {{ $json.payload }} $v$::jsonb)\non conflict (filing_id, ticker, action, coalesce(instrument,''), transaction_date, coalesce(description,'')) do nothing;",
