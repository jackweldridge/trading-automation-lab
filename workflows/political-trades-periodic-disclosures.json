        "jsCode": "const item = $input.first();\nconst results = [];\n\nfor (const [key, binaryData] of Object.entries(item.binary)) {\n  results.push({\n    json: { fileName: binaryData.fileName || key },\n    binary: { data: binaryData }\n  });\n}\n\nreturn results;"
