    {
      "parameters": {
        "jsCode": "// ============================================\n// TOGGLE — switch between modes here\n// 'names'  → filter by watchlist, P filings only\n// 'recent' → all P filings from the last N days\n// ============================================\nconst MODE           = 'recent';   // 'names' or 'recent'\nconst NAMES_TO_WATCH = ['Steube'];\nconst RECENT_DAYS    = 4;\n\n// ============================================\nconst xmlString = $input.first().json.data;\n\nconst memberBlocks = xmlString.match(/<Member>[\\s\\S]*?<\\/Member>/g) || [];\n\nconst members = memberBlocks.map(block => {\n  const get = (tag) => {\n    const m = block.match(new RegExp(`<${tag}>([^<]*)<\\/${tag}>`));\n    return m ? m[1].trim() : '';\n  };\n  return {\n    last:       get('Last'),\n    first:      get('First'),\n    filingType: get('FilingType'),\n    stateDst:   get('StateDst'),\n    year:       get('Year'),\n    filingDate: get('FilingDate'),\n    docID:      get('DocID'),\n  };\n});\n\nlet filtered;\n\nif (MODE === 'names') {\n  filtered = members.filter(m => NAMES_TO_WATCH.includes(m.last) && m.filingType === 'P');\n\n  // For name mode — deduplicate to latest filing per person\n  const latestByName = {};\n  for (const m of filtered) {\n    const date = new Date(m.filingDate);\n    if (!latestByName[m.last] || date > new Date(latestByName[m.last].filingDate)) {\n      latestByName[m.last] = m;\n    }\n  }\n  filtered = Object.values(latestByName);\n\n} else {\n  // recent mode — all P filings within last RECENT_DAYS days\n  const cutoff = new Date();\n  cutoff.setHours(0, 0, 0, 0);\n  cutoff.setDate(cutoff.getDate() - RECENT_DAYS);\n\n  filtered = members.filter(m => {\n    if (m.filingType !== 'P') return false;\n    const date = new Date(m.filingDate);\n    return date >= cutoff;\n  });\n}\n\nif (filtered.length === 0) {\n  return [{ json: { debug: true, mode: MODE, blockCount: memberBlocks.length, cutoffOrNames: MODE === 'names' ? NAMES_TO_WATCH : RECENT_DAYS + ' day(s)' } }];\n}\n\nreturn filtered.map(m => ({ json: m }));"
      },
