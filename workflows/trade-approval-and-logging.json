    {
      "parameters": {
        "jsCode": "/**\n * secdef/search handler for n8n Code node\n * - Safe against missing fields\n * - Keeps only STK\n * - Dedupes by conId\n * - Keeps only LSE / NYSE / NASDAQ\n * - Sorts by exchange preference\n * - Returns all valid matches\n */\n\nconst rawItems = $input.all();\n\n// normalize json payloads\nconst data = rawItems\n  .map(i => i.json)\n  .filter(i => i && typeof i === 'object');\n\n// helper: STK check (new structure)\nfunction isStock(item) {\n  return item.secType === 'STK';\n}\n\n// helper: exchange text\nfunction getExchangeText(item) {\n  return (\n    (item.exchange || '') + ' ' +\n    (item.primaryExchange || '')\n  ).toUpperCase();\n}\n\nfunction isAllowedExchange(item) {\n  const t = getExchangeText(item);\n  return t.includes('LSE') || t.includes('NYSE') || t.includes('NASDAQ') || t.includes('AMEX');\n}\n\n// filter STK + allowed exchanges\nconst filtered = data.filter(i =>\n  isStock(i) && isAllowedExchange(i)\n);\n\nif (filtered.length === 0) {\n  return [{\n    json: {\n      error: 'No LSE/NYSE/NASDAQ/AMEX STK instruments found',\n      inputCount: data.length\n    }\n  }];\n}\n\n// dedupe by conId (note capital I)\nconst seen = new Set();\nconst unique = [];\n\nfor (const item of filtered) {\n  if (!item.conId || item.conId === -1) continue;\n  if (seen.has(item.conId)) continue;\n  seen.add(item.conId);\n  unique.push(item);\n}\n\n// exchange ranking\nfunction rank(item) {\n  const t = getExchangeText(item);\n  if (t.includes('LSE')) return 1;\n  if (t.includes('NYSE')) return 2;\n  if (t.includes('NASDAQ')) return 3;\n  if (t.includes('AMEX')) return 4;\n  return 9;\n}\n\n// sort by preference\nunique.sort((a, b) => rank(a) - rank(b));\n\n// return all matches\nreturn unique.map(i => ({ json: i }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
