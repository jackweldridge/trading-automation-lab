# Copy this file to ".env" in the same folder, then fill in your own values.
# NEVER commit your real .env — .gitignore already excludes it.

# Your Interactive Brokers PAPER login (username and password):
TWS_USERID=your-paper-username
TWS_PASSWORD=your-paper-password

# Your paper account number — starts with "DU", shown in the IBKR portal:
IB_ACCOUNT=DU0000000

# Your timezone as an IANA name (e.g. Europe/London, America/New_York):
TIME_ZONE=Europe/London
